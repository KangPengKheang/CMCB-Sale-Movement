# Vercel dashboard environment variable (Production and Preview)
# Replace the example hostname with your deployed FastAPI backend.
# Include /api and omit the trailing slash.
VITE_API_BASE_URL=https://your-backend.example.com/api

# Only public configuration belongs here: VITE_ values are included in the browser bundle.
# For local Vite development, omit this variable so /api uses the existing localhost proxy.
