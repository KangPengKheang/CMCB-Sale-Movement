# Backend host only: import into the host's environment or use as Docker --env-file.
# This file is not a Vercel frontend environment file.
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000

VISIT_DATA_SOURCE=google_sheets
GOOGLE_SHEETS_ID=1wM7DTHizhg_A3h0qV3EhX4os4hk46uolW-ESQSJkgZs
GOOGLE_SHEETS_TAB=Test3
GOOGLE_SHEETS_GID=1550076852
GOOGLE_SHEETS_REFRESH_SECONDS=15

# Docker/container path; mount a persistent volume at /app/data.
# For a non-container host, replace with an absolute path on its persistent disk.
DATABASE_PATH=/app/data/market_reports_sheets_test3.db

AUTH_SOURCE=users
USERS_SHEET_TAB=Users
USERS_REFRESH_SECONDS=60
SESSION_SECONDS=28800
# The private .env.production contains a generated secret.
# Supply a unique random secret when using this example independently.
AUTH_SECRET_KEY=

# Optional: absolute path to a mounted service-account JSON for a private spreadsheet.
# Leave blank to keep the current public read access.
GOOGLE_SHEETS_CREDENTIALS_FILE=
