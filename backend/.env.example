# ==============================================================================
# Visit Source Configuration
# ==============================================================================
VISIT_DATA_SOURCE=google_sheets
GOOGLE_SHEETS_ID=1wM7DTHizhg_A3h0qV3EhX4os4hk46uolW-ESQSJkgZs
GOOGLE_SHEETS_TAB=Test3
GOOGLE_SHEETS_GID=1550076852
GOOGLE_SHEETS_REFRESH_SECONDS=15
# Optional service-account JSON path for a private sheet (Viewer access only)
GOOGLE_SHEETS_CREDENTIALS_FILE=
# Use a separate DATABASE_PATH when switching from an existing sheet cache.
# Example: DATABASE_PATH=/absolute/path/to/market_reports_sheets_test3.db

# ==============================================================================
# Telegram Bot API Configuration (only used as a visit source in telegram mode)
# ==============================================================================
# Bot token obtained from @BotFather (e.g. 1234567890:ABCdefGhIJKlmNoPQRstuVWXyz)
TELEGRAM_BOT_API=your_telegram_bot_token_here

# Target Telegram Supergroup / Channel ID (e.g. -1001234567890)
TARGET_CHAT_ID=-1001234567890

# (Optional) Specific Forum Topic / Thread ID if supergroup uses topics
TARGET_TOPIC_ID=

# ==============================================================================
# Application & Environment Settings
# ==============================================================================
# Environment mode: test or production; each visit source has its own database defaults
ENVIRONMENT=test

# Maximum correlation window in seconds between photo form and location pin (Default: 900s / 15 mins)
CORRELATION_WINDOW_SECONDS=900

# Server Bind Configuration
HOST=127.0.0.1
PORT=8000

# ==============================================================================
# Legacy Environment Authentication (AUTH_SOURCE=env only)
# ==============================================================================
# Ignored by Users-sheet login; retained only for explicit legacy env mode.
ADMIN_USERNAME=admin

# Salted PBKDF2-HMAC-SHA256 password hash (600,000 iterations + 16-byte random salt)
# Default hash below corresponds to password: "cmcbmarketinsightadmin"
ADMIN_PASSWORD_HASH=pbkdf2:sha256:600000:7b569186f5758a61d2e105dbefc7e915:f8bbf2434b5aa3db164cf9c0c7bb464a3763a5d397cd6bd91708ad931beae856

# Set a unique random secret to sign sessions. The local ignored .env already has one.
AUTH_SECRET_KEY=cmcb-market-insight-admin-auth-secret-2026

# ==============================================================================
# Telegram Mini App (TMA) Bot & Group Access (Coolify .env)
# ==============================================================================
# Bot token for the Mini App bot (if different from the scraper bot)
MINI_APP_BOT_TOKEN=

# Sales team Telegram group ID (starts with -100...). Users must be members of this group.
MINI_APP_CHAT_ID=

# Users worksheet login (default for Google Sheets deployments)
AUTH_SOURCE=users
USERS_SHEET_TAB=Users
USERS_REFRESH_SECONDS=60
SESSION_SECONDS=28800
# Replace AUTH_SECRET_KEY above with a unique random value before running.
